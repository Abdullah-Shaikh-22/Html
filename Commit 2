
<!DOCTYPE html>
<html>
<head>
<title>My Shop</title>
<style>
body {font-family:Arial;background:#f1f5f9;margin:0;text-align:center}
header {background:#2563eb;color:white;padding:25px}
.products {display:flex;justify-content:center;flex-wrap:wrap;gap:20px;padding:30px}
.card {background:white;padding:20px;border-radius:10px;width:200px}
button {background:#2563eb;color:white;padding:10px;border:0;border-radius:5px;cursor:pointer}
</style>
</head>
<body>
<header>
<h1>My Online Store</h1>
<p>Shopping Made Easy</p>
<h3>Cart: <span id="cart">0</span></h3>
</header>
<div class="products">
<div class="card">
<h2>Headphones</h2>
<p>₹999</p>
<button onclick="addCart()">Add to Cart</button>
</div>
<div class="card">
<h2>Smart Watch</h2>
<p>₹1499</p>
<button onclick="addCart()">Add to Cart</button>
</div>
<div class="card">
<h2>Keyboard</h2>
<p>₹799</p>
<button onclick="addCart()">Add to Cart</button>
</div>
</div>
<script>
let count=0;
function addCart(){
count++;
document.getElementById("cart").innerText=count;
}
</script>
</body>
</html>
